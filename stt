#!/usr/bin/env python3
"""Select phone-call STT in this checkout's .env; never print credentials."""
import argparse
import os
from pathlib import Path
import re
import tempfile

ASSEMBLY_MODELS = ('universal-streaming-english', 'universal-streaming-multilingual', 'universal-3-5-pro')
PRESETS = {
    'assemblyai': ('ASSEMBLY_MODEL', ASSEMBLY_MODELS[0], 'ASSEMBLY_API_KEY'),
    'deepgram': ('DEEPGRAM_MODEL', 'nova-3', 'DEEPGRAM_API_KEY'),
    'sarvam': ('SARVAM_MODEL', 'saaras:v3', 'SARVAM_API_KEY'),
    'elevenlabs': ('ELEVENLABS_STT_MODEL', 'scribe_v2_realtime', 'ELEVENLABS_API_KEY'),
    'plivo': ('PLIVO_SPEECH_MODEL', 'phone_call', None),
    # Experimental: self-hosted Manglish Whisper on a scale-to-zero HF Inference
    # Endpoint. No selectable model name; HF_WHISPER_ENDPOINT_URL must also be
    # set manually in .env (endpoint-specific, no sane default to fall back to).
    'whisper_manglish_hf': (None, None, 'HF_WHISPER_API_TOKEN'),
}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('provider', choices=['show', *PRESETS], nargs='?', default='show')
    parser.add_argument('--model', choices=ASSEMBLY_MODELS, help='AssemblyAI streaming model')
    args = parser.parse_args()
    if args.model and args.provider != 'assemblyai':
        parser.error('--model is available with ./stt assemblyai')
    path = Path(__file__).resolve().parent / '.env'
    source = path.read_text() if path.exists() else ''
    values = {}
    for line in source.splitlines():
        match = re.match(r'^\s*(?:export\s+)?([A-Z_]+)\s*=\s*(.*)$', line)
        if match:
            values[match[1]] = match[2].strip().strip('\"\'')
    if not values.get('ASSEMBLY_API_KEY') and values.get('ASSEMBLYAI_API_KEY'):
        values['ASSEMBLY_API_KEY'] = values['ASSEMBLYAI_API_KEY']
    selected = values.get('STT_PROVIDER', 'assemblyai') if args.provider == 'show' else args.provider
    if selected not in PRESETS:
        parser.error('Invalid STT_PROVIDER in .env')
    model_key, default_model, key_name = PRESETS[selected]
    if args.provider != 'show':
        if key_name and (not values.get(key_name) or values[key_name] in {'YOUR_SARVAM_API_KEY', 'your-existing-key'}):
            parser.error(f'Add {key_name} to {path} before selecting {selected}')
        changes = {'STT_PROVIDER': selected}
        if args.model:
            changes[model_key] = args.model
        elif model_key and not values.get(model_key):
            changes[model_key] = default_model
        for key, value in changes.items():
            pattern = r'^\s*(?:export\s+)?' + key + r'\s*=.*$'
            if re.search(pattern, source, re.M):
                source = re.sub(pattern, key + '=' + value, source, flags=re.M)
            else:
                source = source.rstrip('\n') + '\n' + key + '=' + value + '\n'
        mode = path.stat().st_mode & 0o777 if path.exists() else 0o600
        fd, temp = tempfile.mkstemp(dir=path.parent, prefix='.stt-env-')
        try:
            with os.fdopen(fd, 'w') as file:
                file.write(source)
            os.chmod(temp, mode)
            os.replace(temp, path)
        finally:
            if os.path.exists(temp):
                os.unlink(temp)
    if args.provider != 'show':
        values.update(changes)
    if model_key:
        print(f'Phone STT: {selected} | Model: {values.get(model_key) or default_model}')
    else:
        print(f'Phone STT: {selected}')
    print('API key: ' + ('not required for built-in STT' if not key_name else 'SET' if values.get(key_name) else 'MISSING'))
    if selected == 'whisper_manglish_hf':
        print('Endpoint URL: ' + ('SET' if values.get('HF_WHISPER_ENDPOINT_URL') else 'MISSING — set HF_WHISPER_ENDPOINT_URL manually in .env'))
    print('Configuration file:', path)
    if args.provider != 'show':
        print('Apply on this server: docker compose up -d --force-recreate gateway')
        print('If code changed too: docker compose up -d --build gateway')
    else:
        print('Switch: ./stt assemblyai [--model MODEL] | ./stt deepgram | ./stt sarvam | ./stt elevenlabs | ./stt plivo | ./stt whisper_manglish_hf')
    print('Shows .env selection; running containers retain their settings until recreated.')


if __name__ == '__main__':
    main()
