# Telephone carrier default; signed Plivo callbacks remain supported.
TELEPHONY_PROVIDER=plivo
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15717162921
TWILIO_PUBLIC_BASE_URL=https://voice.neuroheart.ai
# Optional: defaults to the existing PLIVO_TRANSFER_NUMBER manager destination.
TWILIO_TRANSFER_NUMBER=

# ── Plivo ─────────────────────────────
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=+14042071333
# Must exactly match the public URL configured as this app's Answer URL —
# the webhook signature is computed over it.
PLIVO_PUBLIC_BASE_URL=https://voice.example.com
TELEPHONY_PORT=8081

# ── Brain (chat_manager) ──────────────
# Container name on the shared compose network — see docker-compose.yml.
CHAT_MANAGER_URL=http://chat-manager-api:8000
# Must match API_KEY in chat_manager's .env. Generate with:
#   openssl rand -hex 32
BRAIN_API_KEY=
BRAIN_API_KEY_HEADER=X-API-Key
BRAIN_TIMEOUT=20.0

# Protects the dashboard-only order, handoff, and call-cost feeds. Generate a
# separate value with `openssl rand -hex 32` and configure the same value as
# TELEPHONY_API_KEY in voice_central.
DASHBOARD_API_KEY=

# ── Transfer ──────────────────────────
PLIVO_TRANSFER_NUMBER=
TRANSFER_TIMEOUT=25

# ── Speech ────────────────────────────
SPEECH_LANGUAGE=en-US
SPEECH_END_TIMEOUT=auto
EXECUTION_TIMEOUT=15
# Optional but the cheapest accuracy win available — without it Plivo's ASR
# mangles "Gobi Kondattam". Generate with:
#   python scripts/generate_hints.py ../chat_manager_repo/menu/menu_flat.json
SPEECH_HINTS=
ELEVENLABS_API_KEY=
# Use the same voice id as the brain's ELEVEN_VOICE (the Indian-accent voice).
ELEVENLABS_VOICE_ID=
# turbo is markedly lower latency, which is audible on a phone call.
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Experimental: self-hosted Manglish Whisper fine-tune on a scale-to-zero HF
# Inference Endpoint. One HTTP call per turn, not a streaming session — a
# cold-started endpoint can take 10s+ to respond after an idle period, and
# CPU-tier endpoints were far too slow for live calls in testing; use a GPU
# (T4+) endpoint. Menu vocabulary is read from menu/menu.csv on each call.
HF_WHISPER_ENDPOINT_URL=
HF_WHISPER_API_TOKEN=
HF_WHISPER_TURN_TIMEOUT=60

# ── Audio cache ───────────────────────
AUDIO_DIR=/data/audio
AUDIO_TTL_SECONDS=600
# Persistent phrase cache — cross-call, survives container restarts.
# Backed by the gateway_phrase_cache Docker volume. Fixed phrases (REPROMPT,
# BRAIN_DOWN_MSG) are pre-synthesized here at startup so ElevenLabs is never
# called twice for the same phrase.
PHRASE_CACHE_DIR=/app/phrase_cache

# ── Orders ────────────────────────────
ORDERS_LOG_PATH=/data/orders/orders.jsonl
COST_LOG_PATH=/data/cost/costs.jsonl
# Production printer/queue API. Leave empty to disable printing safely.
PRINT_API_URL=https://cakeworld.neuroheart.ai
PRINT_API_KEY=

# ── Copy ──────────────────────────────
# The greeting is NOT set here — chat_manager writes it and greets returning
# callers by name. This is only the message the gateway sends to chat_manager
# to elicit that greeting.
GREETING_PROMPT=hello

# Used ONLY when chat_manager or ElevenLabs cannot answer. Everything a caller
# hears on a healthy call comes from chat_manager.
REPROMPT=Sorry, I didn't catch that. Could you repeat it?
BRAIN_DOWN_MSG=Sorry, let me get someone to help you.
TRANSFER_FAILED_MSG=Sorry, no one is free right now. Please call back shortly.

# Phone-call recognition: sarvam, deepgram, or plivo (restart gateway after changing).
STT_PROVIDER=assemblyai
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Nova-3 multilingual decoding; independent of Plivo's SPEECH_LANGUAGE.
DEEPGRAM_LANGUAGE=multi
DEEPGRAM_ENDPOINTING_MS=700
DEEPGRAM_TURN_TIMEOUT=30

# Optional Sarvam phone STT. Select using ./stt sarvam after setting the key.
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v3
SARVAM_LANGUAGE=en-IN
SARVAM_TURN_TIMEOUT=30
# Plivo GetInput models: phone_call, default, command_and_search.
PLIVO_SPEECH_MODEL=phone_call

# Default phone-call STT. Model choices also available via ./stt assemblyai --model ...
ASSEMBLY_API_KEY=
ASSEMBLY_MODEL=universal-streaming-english
ASSEMBLY_TURN_TIMEOUT=30
# Other models: universal-streaming-multilingual, universal-3-5-pro.
# ASSEMBLYAI_API_KEY is accepted as an alias for ASSEMBLY_API_KEY.

# Opt-in customer audio debug clips, delivered to Chat Manager with each transcript.
DEBUG_CUSTOMER_AUDIO=false
# Comma-separated E.164 test callers; empty means all callers when enabled.
DEBUG_AUDIO_CALLERS=
