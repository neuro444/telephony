# ── Plivo ─────────────────────────────
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=
# Must exactly match the public URL configured as this app's Answer URL —
# the webhook signature is computed over it.
PLIVO_PUBLIC_BASE_URL=https://voice.example.com
TELEPHONY_PORT=8081

# ── Brain (chat_manager) ──────────────
# Container name on the shared compose network — see docker-compose.yml.
CHAT_MANAGER_URL=http://chat-manager-api:8000
# Must match API_KEY in chat_manager's .env. Generate with:
#   openssl rand -hex 32
BRAIN_API_KEY=
BRAIN_API_KEY_HEADER=X-API-Key
BRAIN_TIMEOUT=20.0

# ── Transfer ──────────────────────────
PLIVO_TRANSFER_NUMBER=
TRANSFER_TIMEOUT=25

# ── Speech ────────────────────────────
SPEECH_LANGUAGE=en-US
SPEECH_END_TIMEOUT=auto
EXECUTION_TIMEOUT=15
# Optional but the cheapest accuracy win available — without it Plivo's ASR
# mangles "Gobi Kondattam". Generate with:
#   python scripts/generate_hints.py ../chat_manager_repo/menu/menu_flat.json
SPEECH_HINTS=
ELEVENLABS_API_KEY=
# Use the same voice id as the brain's ELEVEN_VOICE (the Indian-accent voice).
ELEVENLABS_VOICE_ID=
# turbo is markedly lower latency, which is audible on a phone call.
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ── Audio cache ───────────────────────
AUDIO_DIR=/data/audio
AUDIO_TTL_SECONDS=600

# ── Orders ────────────────────────────
ORDERS_LOG_PATH=/data/orders/orders.jsonl
COST_LOG_PATH=/data/cost/costs.jsonl
# Production printer/queue API. Leave empty to disable printing safely.
PRINT_API_URL=https://cakeworld.neuroheart.ai

# ── Copy ──────────────────────────────
# The greeting is NOT set here — chat_manager writes it and greets returning
# callers by name. This is only the message the gateway sends to chat_manager
# to elicit that greeting.
GREETING_PROMPT=hello

# Used ONLY when chat_manager or ElevenLabs cannot answer. Everything a caller
# hears on a healthy call comes from chat_manager.
REPROMPT=Sorry, I didn't catch that. Could you repeat it?
BRAIN_DOWN_MSG=Sorry, let me get someone to help you.
TRANSFER_FAILED_MSG=Sorry, no one is free right now. Please call back shortly.
